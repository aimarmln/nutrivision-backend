# -----------------------------------------------------------------------------
# Flask Security
# -----------------------------------------------------------------------------

# Secret key used by Flask for session management and application security.
# Generate a random string with at least 32 characters.
SECRET_KEY=your-secret-key

# Secret key used to sign and verify JWT access and refresh tokens.
# It is recommended to use a different value from SECRET_KEY.
JWT_SECRET_KEY=your-jwt-secret-key

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------

# Main database connection used by SQLAlchemy.
# Format:
# postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/nutrivision

# PostgreSQL connection used by LangGraph checkpoint storage.
# Format:
# postgresql://<username>:<password>@<host>:<port>/<database>
CHECKPOINT_DB_URL=postgresql://username:password@localhost:5432/nutrivision

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------

# Access token expiration time (hours).
JWT_ACCESS_TOKEN_HOURS=2

# Refresh token expiration time (days).
JWT_REFRESH_TOKEN_DAYS=30

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------

# Redis server hostname or IP address.
REDIS_HOST=localhost

# Redis server port.
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Groq API
# -----------------------------------------------------------------------------

# API key used for the Large Language Model (LLM).
# Obtain your API key from:
# https://console.groq.com/
GROQ_API_KEY=your-groq-api-key

# -----------------------------------------------------------------------------
# LangSmith Configuration (Optional but Recommended)
# -----------------------------------------------------------------------------

# Enable LangSmith tracing for debugging and monitoring.
LANGSMITH_TRACING=true

# LangSmith API endpoint.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# API key for LangSmith.
# Obtain your API key from:
# https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key

# Project name displayed in the LangSmith dashboard.
LANGSMITH_PROJECT=NutriVision

# -----------------------------------------------------------------------------
# OpenAI Configuration (Optional)
# -----------------------------------------------------------------------------

# Only required if the application uses OpenAI models.
# Leave empty if not used.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Hugging Face Configuration
# -----------------------------------------------------------------------------

# Access token for downloading models and embeddings from Hugging Face Hub.
# Obtain your token from:
# https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token